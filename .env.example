# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Local SQLite file; use libsql://… + DATABASE_AUTH_TOKEN for Turso
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=
# Outgoing mail (invites, password reset). Without SMTP_URL mails are only logged.
SMTP_URL=smtps://user:password@mail.example.org:465
MAIL_FROM="Tanztraining <tanztraining@example.org>"
